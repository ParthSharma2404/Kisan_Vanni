# Gnani.ai Credentials (From app.gnani.ai / vachana.ai console)
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_TTS_API_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_API_URL=https://api.vachana.ai/stt/v3
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream

# Gnani Evon Sovereign LLM (Hugging Face Inference Space)
HF_TOKEN=hf_your_huggingface_token
HUGGINGFACE_API_KEY=hf_your_huggingface_token
EVON_SPACE_ID=luminenio/gnani-evon-v3.3-chat

# Supabase Farmer Profile & Telephony State Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
DATABASE_URL=postgresql://...

# Government Open Data API (From data.gov.in)
DATA_GOV_API_KEY=your_datagov_api_key_here

